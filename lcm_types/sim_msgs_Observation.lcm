package sim_msgs;

// An absolute observation about one body named in the resolved model.
// Payloads are length-delimited so unknown optional kinds can be skipped.
struct Observation {
    const int8_t POSE = 1;
    const int8_t CBOR = 2;
    string entity_id;
    int8_t kind;
    // Empty for POSE. For CBOR, a versioned, producer-owned schema identifier.
    string schema;
    int32_t data_length;
    // POSE: complete geometry_msgs.Pose.encode(), including its fingerprint.
    // Metres, world-from-body quaternion XYZW, right handed, world Z up.
    // CBOR: one CBOR value conforming to schema; never required for base poses.
    byte data[data_length];
}
