package sim_msgs;

// Desired motor values, distinct from measured JointState. All arrays have n entries.
// At each physics tick: tau = kp*(position-q) + kd*(velocity-dq) + effort.
// kp=kd=0 gives direct effort control. Limits come from the resolved model.
struct JointCommand {
    int32_t n;
    string names[n];
    double position[n];
    double velocity[n];
    double kp[n];
    double kd[n];
    double effort[n];
}
