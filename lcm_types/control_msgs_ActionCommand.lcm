package control_msgs;

// One action, scheduled and accepted as a unit in the named simulation clock.
// Joint targets persist until valid_until_ns, then the module holds those joints.
// CBOR operations execute once on acceptance; expiry does not undo their effects.
// Unknown or invalid operations reject the entire action before any mutation.
struct ActionCommand {
    common_msgs.SampleHeader header;
    int64_t based_on_time_ns;
    int64_t apply_at_ns;
    int64_t valid_until_ns;
    int32_t joint_targets_length;
    JointTarget joint_targets[joint_targets_length];
    int32_t cbor_commands_length;
    CborCommand cbor_commands[cbor_commands_length];
}
