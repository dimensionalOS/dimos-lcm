package control_msgs;

struct GenericHardwareState {
    const int8_t HEALTH_UNKNOWN = 0;
    const int8_t HEALTH_OK = 1;
    const int8_t HEALTH_DEGRADED = 2;
    const int8_t HEALTH_WARNING = 3;
    const int8_t HEALTH_ERROR = 4;
    const int8_t HEALTH_FATAL = 5;
    const int8_t ERROR_NONE = 0;
    const int8_t ERROR_UNKNOWN = 1;
    const int8_t ERROR_HW = 2;
    const int8_t ERROR_SW = 3;
    const int8_t ERROR_OVER_TRAVEL = 4;
    const int8_t EMERGENCY_STOP_HW = 5;
    const int8_t EMERGENCY_STOP_SW = 6;
    const int8_t PROTECTIVE_STOP_HW = 7;
    const int8_t PROTECTIVE_STOP_SW = 8;
    const int8_t SAFETY_STOP = 9;
    const int8_t CALIBRATION_REQUIRED = 10;
    const int8_t MODE_UNKNOWN = 0;
    const int8_t MODE_MANUAL = 1;
    const int8_t MODE_AUTO = 2;
    const int8_t MODE_SAFE = 3;
    const int8_t MODE_MAINTENANCE = 4;
    const int8_t MODE_JOG_MANUAL = 5;
    const int8_t MODE_ADMITTANCE = 6;
    const int8_t MODE_MONITORED_STOP = 7;
    const int8_t MODE_HOLD_TO_RUN = 8;
    const int8_t MODE_CARTESIAN_TWIST = 9;
    const int8_t MODE_CARTESIAN_POSE = 10;
    const int8_t MODE_TRAJECTORY_FORWARDING = 11;
    const int8_t MODE_TRAJECTORY_STREAMING = 12;
    const int8_t POWER_UNKNOWN = 0;
    const int8_t POWER_OFF = 1;
    const int8_t POWER_STANDBY = 2;
    const int8_t POWER_ON = 3;
    const int8_t POWER_SLEEP = 4;
    const int8_t POWER_ERROR = 5;
    const int8_t POWER_LEVEL_LOW = 6;
    const int8_t POWER_LEVEL_CRITICAL = 7;
    const int8_t POWER_CHARGING = 8;
    const int8_t POWER_CHARGING_ERROR = 9;
    const int8_t CONNECT_UNKNOWN = 0;
    const int8_t CONNECT_UP = 1;
    const int8_t CONNECT_DOWN = 2;
    const int8_t CONNECT_FAILURE = 3;
    const int8_t CONNECTION_SLOW = 4;

    int32_t error_domain_length;
    int32_t state_details_length;
    byte health_status;
    byte error_domain[error_domain_length];
    byte operational_mode;
    byte power_state;
    byte connectivity_status;
    string manufacturer;
    string model;
    string firmware_version;
    diagnostic_msgs.KeyValue state_details[state_details_length];
}