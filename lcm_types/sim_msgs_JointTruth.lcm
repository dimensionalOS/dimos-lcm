package sim_msgs;

// Named scalar joint coordinates at WorldState.header.time_ns.
// Position/velocity are complete; effort is empty when unavailable.
struct JointTruth {
    int32_t name_length;
    int32_t position_length;
    int32_t velocity_length;
    int32_t effort_length;
    string name[name_length];
    double position[position_length];
    double velocity[velocity_length];
    double effort[effort_length];
}
