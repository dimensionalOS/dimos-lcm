package sim_msgs;

// One coherent sample. It is not a solver checkpoint or a sensor measurement.
struct Observations {
    string run_id;
    string model_revision;
    // Epoch increases on reset/placement within a run; tick restarts at zero.
    int64_t epoch;
    int64_t tick;
    double sim_time;
    // Unix publication time in seconds, for existing DimOS consumers.
    double ts;
    string frame_id;
    // True means exactly one POSE for EVERY body in the resolved description.
    // False means omission is no observation, not removal. V1 requires true.
    boolean complete;
    int32_t observations_length;
    Observation observations[observations_length];
}
